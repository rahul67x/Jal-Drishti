# ---------------------------------------------------------------------------
# Local-only credentials for the seeding scripts in scripts/
#
# Copy to .env.seed and fill in. NEVER commit .env.seed, and never move these
# values into a VITE_ variable — anything prefixed VITE_ is bundled into the
# browser build.
#
# The service_role key bypasses Row Level Security completely. Treat it like a
# database root password: local machine only.
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

{
  "name": "jaldrishti",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:parse": "node scripts/parse-analysed-data.mjs",
    "db:seed-sql": "node scripts/generate-seed-sql.mjs",
    "db:build": "npm run db:parse && npm run db:seed-sql",
    "db:verify": "node scripts/verify-schema.mjs",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "db:upload-rasters": "node --env-file=.env.seed scripts/upload-rasters.mjs",
    "report:render": "node --env-file=.env.local scripts/render-report.mjs",
    "tour:check": "node scripts/check-tour-anchors.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "browser-image-compression": "^2.0.2",
    "exifr": "^7.1.3",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}

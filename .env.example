# ---------------------------------------------------------------------------
# JalDrishti environment configuration
#
# Copy this file to .env.local and fill in the values from your Supabase
# project dashboard: Project Settings > API
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The anon / public key.
#
# This key is compiled into the browser bundle and is readable by anyone. That
# is safe ONLY because Row Level Security is enabled on every table. It allows
# reading published content and nothing else.
#
# Do NOT put the service_role key here. It bypasses every security policy, and
# any VITE_ variable is shipped to the browser. src/lib/supabase.ts will refuse
# to start if it detects a non-anon key.
VITE_SUPABASE_ANON_KEY=
